{
  "name": "ferryman-dsh",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Ferryman 原生 dsh 插件——闸门问询/归还播种/用量上报/判活转发/挂载自检 + 被拦反馈双面包（票08 对话区选择框）",
  "main": "index.mjs",
  "exports": {
    "./client": "./client.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/*.test.ts\""
  }
}
