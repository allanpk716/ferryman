{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferryman Widget",
  "version": "0.2.0",
  "identifier": "com.ferryman.widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "title": "Ferryman 用量悬浮窗",
        "width": 132,
        "height": 620,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QUQxMTBGNDJCNTIzRTkKUldUcEk3VkNEeEd0R2NVMVd3TEJScnBQVENmRzZ0TGF4Vksza3hxcGV5T2VPM0M5RXZJOVNJUEoK",
      "endpoints": [
        "https://github.com/allanpk716/ferryman/releases/download/widget-latest/latest.json"
      ]
    }
  }
}
