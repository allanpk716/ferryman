{
  "name": "tool_call",
  "description": "工具调用形：带工具定义 + 工具调用历史（function_call/function_call_output）+ parallel_tool_calls:false 的续轮请求；上游回文本块 + tool_use 块（对照表 §1.2 重嵌套/§1.3 tools 与 tool_choice/§2.2 工具流事件序）。model 用未知名，供翻译分支 codex 主模型键改写断言（§5.3）。",
  "codex_request": {
    "model": "gpt-7-fixture",
    "instructions": "你是文件助手。",
    "max_output_tokens": 1024,
    "stream": true,
    "parallel_tool_calls": false,
    "tool_choice": "auto",
    "store": false,
    "prompt_cache_key": "fixture-tool-cache-key",
    "tools": [
      {
        "type": "function",
        "name": "list_files",
        "description": "列出目录内容",
        "parameters": {
          "type": "object",
          "properties": { "path": { "type": "string", "description": "目录路径" } },
          "required": ["path"]
        }
      },
      {
        "type": "function",
        "name": "read_file",
        "description": "读取文件内容",
        "parameters": {
          "type": "object",
          "properties": { "path": { "type": "string", "description": "文件路径" } },
          "required": ["path"]
        }
      }
    ],
    "input": [
      { "role": "user", "content": [{ "type": "input_text", "text": "看看仓库里有哪些 Go 文件。" }] },
      { "type": "function_call", "call_id": "call_fx_ls_1", "name": "list_files", "arguments": "{\"path\": \".\"}" },
      { "type": "function_call_output", "call_id": "call_fx_ls_1", "output": "main.go\ngo.mod" },
      { "role": "user", "content": [{ "type": "input_text", "text": "再读一下 main.go。" }] }
    ]
  },
  "anthropic_upstream": {
    "status": 200,
    "content_type": "text/event-stream",
    "sse": [
      { "event": "message_start", "data": "{\"type\":\"message_start\",\"message\":{\"id\":\"msg_fx_tool\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"kimi-k3-coder\",\"content\":[],\"stop_reason\":null,\"usage\":{\"input_tokens\":88,\"output_tokens\":1}}}" },
      { "event": "content_block_start", "data": "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}" },
      { "event": "content_block_delta", "data": "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"好的，先读文件。\"}}" },
      { "event": "content_block_stop", "data": "{\"type\":\"content_block_stop\",\"index\":0}" },
      { "event": "content_block_start", "data": "{\"type\":\"content_block_start\",\"index\":1,\"content_block\":{\"type\":\"tool_use\",\"id\":\"toolu_fx_read_1\",\"name\":\"read_file\",\"input\":{}}}" },
      { "event": "content_block_delta", "data": "{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"path\\\":\"}}" },
      { "event": "content_block_delta", "data": "{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\"src/main.go\\\"}\"}}" },
      { "event": "content_block_stop", "data": "{\"type\":\"content_block_stop\",\"index\":1}" },
      { "event": "message_delta", "data": "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\"},\"usage\":{\"output_tokens\":40}}" },
      { "event": "message_stop", "data": "{\"type\":\"message_stop\"}" }
    ]
  },
  "responses_upstream": {
    "status": 200,
    "content_type": "text/event-stream",
    "sse": [
      { "event": "response.created", "data": "{\"type\":\"response.created\",\"response\":{\"id\":\"resp_fx_tool\",\"object\":\"response\",\"created_at\":0,\"status\":\"in_progress\",\"model\":\"kimi-k3-turbo\",\"output\":[]}}" },
      { "event": "response.output_item.added", "data": "{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"id\":\"fc_native_1\",\"type\":\"function_call\",\"status\":\"in_progress\",\"call_id\":\"call_native_1\",\"name\":\"read_file\",\"arguments\":\"\"}}" },
      { "event": "response.function_call_arguments.delta", "data": "{\"type\":\"response.function_call_arguments.delta\",\"item_id\":\"fc_native_1\",\"output_index\":0,\"delta\":\"{\\\"path\\\": \\\"src/main.go\\\"}\"}" },
      { "event": "response.function_call_arguments.done", "data": "{\"type\":\"response.function_call_arguments.done\",\"item_id\":\"fc_native_1\",\"output_index\":0,\"arguments\":\"{\\\"path\\\": \\\"src/main.go\\\"}\"}" },
      { "event": "response.output_item.done", "data": "{\"type\":\"response.output_item.done\",\"output_index\":0,\"item\":{\"id\":\"fc_native_1\",\"type\":\"function_call\",\"status\":\"completed\",\"call_id\":\"call_native_1\",\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\": \\\"src/main.go\\\"}\"}}" },
      { "event": "response.completed", "data": "{\"type\":\"response.completed\",\"response\":{\"id\":\"resp_fx_tool\",\"object\":\"response\",\"created_at\":0,\"status\":\"completed\",\"model\":\"kimi-k3-turbo\",\"output\":[],\"usage\":{\"input_tokens\":90,\"output_tokens\":30,\"total_tokens\":120}}}" }
    ]
  }
}
